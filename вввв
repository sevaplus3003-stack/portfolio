  { label: "Instagram", href: "https://instagram.com/…", icon: "instagram" },
  { label: "Telegram", href: "https://t.me/…", icon: "telegram" },
  { label: "WhatsApp", href: "https://wa.me/74951203840", icon: "whatsapp" },
